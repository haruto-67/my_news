# .env にコピーして値を設定する（.env はgit管理外）

# Discord webhook URL（専用の1人サーバーのチャンネルに作成したもの）
DISCORD_WEBHOOK_URL=

# カテゴリ別に分ける場合（任意・未設定なら DISCORD_WEBHOOK_URL を全カテゴリ共通で使用）
# DISCORD_WEBHOOK_URL_HOBBY=
# DISCORD_WEBHOOK_URL_MY_IT=
# DISCORD_WEBHOOK_URL_WIDE_IT=

# GitHub PagesのURL（Discord通知のリンク先を記事詳細ページにするために使用。
# 末尾スラッシュの有無はどちらでも可。未設定の場合は元記事URLに直接リンクする）
SITE_BASE_URL=https://haruto-67.github.io/my_news/
